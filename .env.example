# Claves OPCIONALES de enriquecimiento (copiar a .env y rellenar).
# Sin claves, el módulo "Enriquecimiento_API" se omite con una nota;
# el resto de la herramienta funciona igual.

# https://numverify.com/ - lookup enriquecido (plan gratuito: 100 req/mes)
DP_NUMVERIFY_KEY=

# https://www.twilio.com/docs/lookup - Lookup de Twilio
DP_TWILIO_SID=
DP_TWILIO_TOKEN=
